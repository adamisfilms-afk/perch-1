# Copy to .env.local for local development. Never commit real values.

# Supabase (Sydney region in production)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Where the app is served (used in email links)
APP_URL=http://localhost:3000

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# Cal.com
CALCOM_INTAKE_URL=https://cal.com/your-team/intake
CALCOM_RECRUITMENT_URL=https://cal.com/your-team/screening
CALCOM_INTAKE_SLUG=intake
CALCOM_SCREENING_SLUG=screening
CALCOM_WEBHOOK_SECRET=

# Email (Resend) and SMS (Twilio, Australian number or Messaging Service SID)
RESEND_API_KEY=
EMAIL_FROM="The Switchboard <hello@example.com>"
EMAIL_REPLY_TO=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Optional: Slack incoming webhook for coordinator alerts
SLACK_WEBHOOK_URL=

# Documenso (clinician service agreement)
DOCUMENSO_URL=https://app.documenso.com
DOCUMENSO_API_KEY=
DOCUMENSO_TEMPLATE_ID=
DOCUMENSO_TEMPLATE_RECIPIENT_ID=1
DOCUMENSO_WEBHOOK_SECRET=
AGREEMENT_VERSION=2026-09

# ABN Lookup web services GUID (free: https://abr.business.gov.au/Tools/WebServices)
ABN_LOOKUP_GUID=

# Mapbox (suburb → map coordinates)
MAPBOX_TOKEN=

# Cloudflare Turnstile (spam protection on public forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Local stacks and previews only: skip the spam check when no secret is set
TURNSTILE_DISABLED=false
